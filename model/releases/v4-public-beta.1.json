  "scope": "Taiwan county/city executive election candidate vote shares and winner probabilities",
  "architecture": {
    "partisan_baseline": "Partisan Baseline 4.0A weighted regularized KMT-DPP structural model",
    "two_party_stack": {
      "space": "logit",
      "r4_weight": 0.9,
      "legacy_weight": 0.1,
      "selection_cycle": 2018
    },
    "nonmajor_mass": {
      "model": "T3_roster_type",
      "alpha": 0.3,
      "features": [
        "previous_nonmajor_share",
        "council_independent_share",
        "town_independent_share",
        "town_available",
        "faction_propensity",
        "log_nonmajor_candidate_count",
        "has_tpp_candidate",
        "log_independent_candidate_count",
        "log_minor_party_candidate_count"
      ],
      "blend_space": "share",
      "model_weight": 0.7,
      "carry_weight": 0.3,
      "selection_cycle": 2018
    },
    "reliability_gate": {
      "score": "tv_disagreement + nonmajor_jump",
      "threshold": 0.075,
      "inside_envelope": "use compositional structural/candidate correction",
      "outside_envelope": "fallback to direct candidate fundamentals",
      "selection_cycle": 2018
    },
    "winner_probability": {
      "method": "Monte Carlo Gaussian perturbation of log point shares",
      "sigma": 0.95,
      "draws_per_race_validation": 12000,
      "sigma_selection_metric": "multiclass Brier score",
      "selection_cycle": 2018
    }
  },
